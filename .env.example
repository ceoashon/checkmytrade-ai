# Copy to .env for local dev (netlify dev reads it). In production, set these in
# Netlify: Site configuration > Environment variables. Never commit real values.

# --- AI (leave blank to run in MOCK MODE with realistic fake grades) ---
ANTHROPIC_API_KEY=
GRADE_MODEL=claude-sonnet-5-5
QA_MODEL=claude-haiku-5-5
# low | medium | high. Lower is faster and cheaper. Grading must finish in about 30 seconds.
GRADE_EFFORT=medium
QA_EFFORT=low
# 5m or 1h prompt cache lifetime for the knowledge files
CACHE_TTL=5m
# Set to true to force mock mode even when a key is present
MOCK_MODE=
# Server-side refusal fallback for the grading model (true/false)
ENABLE_REFUSAL_FALLBACK=true

# --- Supabase (Project Settings > API) ---
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Server only. Never expose this in front-end code.
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_CHART_BUCKET=cmt-charts

# --- Guardrails ---
DAILY_GRADE_LIMIT=5
DAILY_QUESTION_LIMIT=20
# Day boundary for the daily limits
RATE_LIMIT_TZ=America/New_York
# How many coach calibration examples go into each grading prompt
CALIBRATION_EXAMPLES=6

# --- Local dev only: sign in without Supabase (ignored on the production deploy) ---
ALLOW_DEV_AUTH=
