{
  "name": "checkmytrade-ai",
  "version": "0.1.0",
  "private": true,
  "description": "AI trade grader and course Q&A for Solomon's Circle (TheStrat).",
  "type": "commonjs",
  "engines": { "node": ">=20" },
  "scripts": {
